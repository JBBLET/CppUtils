{
    "version": 6,
    "configurePresets": [
        {
            "name": "gcc16",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "dev",
            "inherits": "gcc16",
            "cacheVariables": {
                "CPPPROJECTS_TEST_CPP_UTILS": "OFF",
                "CPPPROJECTS_TEST_CSV": "OFF",
                "CPPPROJECTS_TEST_JSON": "OFF",
                "CPPPROJECTS_TEST_CSV_DIFF": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "gcc16",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        }
    ]
}
